{
  "name": "deepseek-monitor",
  "version": "1.0.0",
  "description": "DeepSeek API 余额 & Token 用量监控桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE= && electron .",
    "pack": "electron-builder --win portable",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.deepseek.monitor",
    "productName": "DeepSeek Monitor",
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "backend/**/*",
      "assets/**/*",
      "!docs/**",
      "!dev-logs/**",
      "!CLAUDE.md",
      "!*.jpg",
      "!*.png",
      "!*.pdf",
      "!启动App.bat"
    ],
    "extraResources": [],
    "asar": true,
    "asarUnpack": []
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-auto-launch": "^5.0.7",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1"
  }
}
